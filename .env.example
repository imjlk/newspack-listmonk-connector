# Copy to .env or export these variables before running:
# pnpm run smoke:listmonk

LISTMONK_BASE_URL=https://listmonk.example.com
LISTMONK_API_USER=api_user
LISTMONK_API_TOKEN=replace-me
LISTMONK_DEFAULT_LIST_IDS=1
LISTMONK_FROM_EMAIL=Newsroom <news@example.com>

# Optional local Docker Compose settings used by:
# pnpm run listmonk:start
LISTMONK_DOCKER_PORT=9000
LISTMONK_POSTGRES_PORT=15432
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=listmonk123
LISTMONK_ADMIN_API_USER=wp_typia_smoke

# Override only if wp-env cannot reach the host through host.docker.internal.
LISTMONK_WP_BASE_URL=http://host.docker.internal:9000
